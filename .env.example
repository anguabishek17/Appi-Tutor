# Application
APP_NAME="AppiTutors"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (MySQL 8+ InnoDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=appitutors_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session & Security
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
CSRF_TOKEN_SECRET=change_this_to_a_random_32_byte_string_in_production

# Firebase Configuration
FIREBASE_PROJECT_ID=appitutors-demo
FIREBASE_CREDENTIALS_PATH=../config/firebase_credentials.json
# Optional Firebase Client Web Config (used by frontend scripts)
FIREBASE_API_KEY=AIzaSyDemoApiKey1234567890
FIREBASE_AUTH_DOMAIN=appitutors-demo.firebaseapp.com
FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Storage Paths (relative to project root or absolute)
STORAGE_PATH=storage
DBS_STORAGE_PATH=storage/dbs_credentials
LOG_PATH=storage/logs

# Email / SMTP Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@appitutors.co.uk
MAIL_FROM_NAME="AppiTutors"

