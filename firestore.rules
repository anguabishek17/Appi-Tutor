rules_version = '2';

/**
 * UK Tutoring Platform - Cloud Firestore Security Rules
 * Foundation Phase (F01)
 *
 * Security Model:
 * - Default Deny: All client reads and writes are blocked by default.
 * - Future authorization architecture:
 *   1. Roles derived from server-side verified Firebase Auth Custom Claims (e.g. admin, tutor, client).
 *   2. Identity and resource ownership verification (request.auth.uid == resource.data.userId).
 *   3. All privileged operations and mutations must occur through Cloud Functions 2nd Gen.
 *   4. Client direct writes to sensitive/system collections are strictly prohibited.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all client access across all collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
