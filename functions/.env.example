# Functions Environment Configuration Example
# Copy this to .env.local for local testing if needed
# DO NOT commit .env or real secret keys to source control

# Environment
NODE_ENV=development
APP_ENV=local

# Firebase & Region
FIREBASE_REGION=europe-west2

# External Services (Placeholders for future phases)
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=notifications@uktutoring.example.com

# Feature Flags
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=false
